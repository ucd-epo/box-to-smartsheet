# Copy this file to .env and fill in your values.
# NEVER commit .env. It holds your API tokens.

# Box access token (a developer token works for testing; it expires in ~60 min)
BOX_TOKEN=

# Smartsheet API access token
SMARTSHEET_TOKEN=

# Number after /folder/ in the Box folder URL
BOX_FOLDER_ID=

# Smartsheet: File > Properties > Sheet ID
SHEET_ID=

# Column whose value matches the file names (without extension)
KEY_COLUMN_TITLE=

# true = only report what would be attached; false = actually upload
DRY_RUN=true
